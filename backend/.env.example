# Copy this file to `.env` and fill in your values.

# Your Anthropic API key — get one at https://console.anthropic.com/
# The app will still run without it, but the tutor won't be able to respond.
ANTHROPIC_API_KEY=

# The teaching model.
#   claude-opus-4-8  -> highest quality teacher (default)
#   claude-sonnet-5  -> ~5x cheaper, still excellent — recommended for a full
#                       0-to-hero journey where she'll generate a LOT of content.
PRIMER_MODEL=claude-opus-4-8

# A simple passcode Prakruthi types once to log in. Change it to anything you like.
PRIMER_PASSCODE=prakruthi

# Where the SQLite database lives (relative paths are fine).
DATABASE_URL=sqlite:///./primer.db

# Comma-separated list of origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
